# Danh sách khóa API Google Gemini (hỗ trợ xoay vòng đa khóa, phân tách bằng dấu phẩy)
# Lấy khóa miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=YOUR_API_KEY_1,YOUR_API_KEY_2

# Hoặc sử dụng 1 khóa API đơn lẻ:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Cấu hình Phân tầng Mô hình AI Đám mây (Tùy chọn)
GEMINI_TIER1_MODEL=gemini-3.8-flash
GEMINI_TIER2_MODEL=gemini-3.5-flash
GEMINI_TIER3_MODEL=gemini-3.5-flash-lite
GEMINI_COOLDOWN_SECONDS=60.0
